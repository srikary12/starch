<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Starch</string>
	<key>CFBundleDisplayName</key>
	<string>Starch</string>
	<key>CFBundleExecutable</key>
	<string>Starch</string>

	<!--
	  Frozen after the first public release: macOS keys Accessibility grants
	  and Keychain ACLs off this identifier, so changing it silently
	  de-authorises every existing install. Must match Brand.bundleIdentifier,
	  which the app asserts at launch in debug builds.
	-->
	<key>CFBundleIdentifier</key>
	<string>dev.starch.Starch</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>

	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>

	<!-- Menu bar utility: no Dock icon, no app switcher entry. -->
	<key>LSUIElement</key>
	<true/>

	<key>NSHumanReadableCopyright</key>
	<string>Licensed under the Apache License, Version 2.0.</string>

	<!--
	  The right-click → Starch entry.

	  NSMessage is the bare method name; the actual selector is
	  rewriteSelection:userData:error: on ServicesProvider, which is installed
	  as NSApp.servicesProvider at launch.

	  NSReturnTypes is declared even though the handler never writes back to
	  the pasteboard. Returning text there would make macOS replace the
	  selection for us — no Accessibility needed — but it forces a blocking
	  call with no streaming overlay, so we decline it. What the declaration
	  buys is menu placement: the item then shows up in editable text contexts,
	  which is where replacing the selection makes sense.

	  Discovery is cached hard by macOS: the app generally has to live in
	  /Applications. See `make register-services`.
	-->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Starch</string>
			</dict>
			<key>NSMessage</key>
			<string>rewriteSelection</string>
			<key>NSPortName</key>
			<string>Starch</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSReturnTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
