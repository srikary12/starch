<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Starch</string>
	<key>CFBundleDisplayName</key>
	<string>Starch</string>
	<key>CFBundleExecutable</key>
	<string>Starch</string>

	<!--
	  Frozen after the first public release: macOS keys Accessibility grants
	  and Keychain ACLs off this identifier, so changing it silently
	  de-authorises every existing install. Must match Brand.bundleIdentifier,
	  which the app asserts at launch in debug builds.
	-->
	<key>CFBundleIdentifier</key>
	<string>dev.starch.Starch</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>

	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>

	<!-- Menu bar utility: no Dock icon, no app switcher entry. -->
	<key>LSUIElement</key>
	<true/>

	<key>NSHumanReadableCopyright</key>
	<string>Licensed under the Apache License, Version 2.0.</string>

	<!--
	  The right-click → Starch entry.

	  NSMessage is the bare method name; the actual selector is
	  rewriteSelection:userData:error: on ServicesProvider, which is installed
	  as NSApp.servicesProvider at launch.

	  There is deliberately no NSReturnTypes. Declaring it would let macOS
	  replace the selection for us, with no Accessibility work at all — which
	  is tempting and wrong, because it forces a blocking call with no
	  streaming overlay. We do the replacement ourselves.

	  Leaving it out also matters for visibility, which is easy to get
	  backwards: a service that declares return types is only *enabled* where
	  the selection is editable, since macOS needs somewhere to put what comes
	  back. Send-only services appear against any text selection. Because we
	  never write to the pasteboard, declaring return types would have bought
	  nothing and hidden the item everywhere read-only.

	  Discovery is cached hard by macOS: the app generally has to live in
	  /Applications. See `make register-services`.
	-->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Starch</string>
			</dict>
			<key>NSMessage</key>
			<string>rewriteSelection</string>
			<key>NSPortName</key>
			<string>Starch</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
